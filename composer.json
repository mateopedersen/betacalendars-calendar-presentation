{
  "name": "betacalendars/calendar-presentation",
  "type": "library",
  "description": "Framework-agnostic, localized and accessible calendar presentation models and renderers for PHP.",
  "keywords": ["calendar", "date", "month-grid", "presentation", "localization", "accessibility", "php"],
  "homepage": "https://www.betacalendars.com/",
  "license": "MIT",
  "authors": [
    {"name": "Beta Calendars", "homepage": "https://www.betacalendars.com/", "role": "Maintainer"}
  ],
  "support": {
    "issues": "https://github.com/mateopedersen/betacalendars-calendar-presentation/issues",
    "source": "https://github.com/mateopedersen/betacalendars-calendar-presentation"
  },
  "require": {"php": ">=8.3"},
  "suggest": {"ext-intl": "Enables locale-aware month, weekday, and accessibility labels."},
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {"psr-4": {"BetaCalendars\\CalendarPresentation\\": "src/"}},
  "autoload-dev": {"psr-4": {"BetaCalendars\\CalendarPresentation\\Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs --standard=PSR12 src tests",
    "check": ["@validate", "@test", "@analyse", "@cs"],
    "validate": "composer validate --strict"
  },
  "config": {"sort-packages": true, "platform": {"php": "8.3.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
